{
  "name": "texera-control-panel",
  "version": "0.1.0",
  "description": "Windows desktop control panel to set up, deploy, and monitor a single-node Texera stack via Docker.",
  "license": "Apache-2.0",
  "main": "dist/src/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "20.14.9",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "typescript": "5.5.4"
  }
}
